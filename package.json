{
  "name": "cloudlay3r",
  "version": "0.1.0",
  "private": true,
  "main": "public/electron.js",
  "homepage": "./",
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "electron-debug": "^4.1.0",
    "electron-log": "^5.4.0",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.6.2",
    "minio": "^8.0.5",
    "node-schedule": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-scripts": "5.0.1",
    "sass": "^1.89.0",
    "source-map-support": "^0.5.21",
    "stream-throttle": "^0.1.3",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postinstall": "patch-package",
    "build-electron": "esbuild src/electron/main.ts --bundle --platform=node --outfile=public/electron.js",
    "electron-dev": "concurrently \"cross-env NODE_ENV=development BROWSER=none yarn start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-pack": "rm -rf dist/ && yarn build-electron && yarn build && electron-builder --arm64 --universal",
    "electron-build": "rm -rf dist/ && yarn build-electron && yarn build && tsc && electron ."
  },
  "build": {
    "appId": "com.cloudlay3r.app",
    "productName": "Cloudlay3r",
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "target": "pkg"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/node-schedule": "^2.1.7",
    "@types/stream-throttle": "^0.1.4",
    "concurrently": "^9.1.2",
    "cpy-cli": "^5.0.0",
    "cross-env": "^7.0.3",
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12",
    "electron-devtools-installer": "^4.0.0",
    "electron-reload": "^2.0.0-alpha.1",
    "electron-reloader": "^1.2.3",
    "esbuild": "^0.25.5",
    "import-glob-loader": "^1.1.0",
    "patch-package": "^8.0.0",
    "wait-on": "^8.0.3"
  }
}